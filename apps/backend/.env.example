# ==========================
# 应用基础配置（所有环境共享）
# ==========================
# HTTP 服务监听端口
PORT=3000
# 跨域白名单；多个来源用英文逗号分隔，开发环境通常留空
CORS_ORIGINS=

# ==========================
# 数据库配置（mysql / postgres）
# ==========================
DB_TYPE=postgres
# 数据库主机地址
DB_HOST=127.0.0.1
# 数据库端口；PostgreSQL 默认 5432，MySQL 默认 3306
DB_PORT=5432
# 数据库用户名
DB_USERNAME=postgres
# 数据库密码
DB_PASSWORD=your-db-password
# 数据库名
DB_DATABASE=llmops
# 是否自动同步表结构；生产环境必须为 false
DB_SYNC=true

# ==========================
# Redis 配置
# ==========================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Redis 用户名；没有则留空
REDIS_USERNAME=
# Redis 密码；没有则留空
REDIS_PASSWORD=
# Redis 逻辑数据库编号
REDIS_DB=0
# Redis key 前缀，避免和其他项目冲突
REDIS_KEY_PREFIX=llmops:

# ==========================
# 认证配置
# ==========================
# Access Token 签名密钥
JWT_ACCESS_SECRET=please-change-me-access
# Access Token 过期时间，例如 15m / 1h / 1d
JWT_ACCESS_EXPIRES_IN=30m
# Refresh Token 签名密钥
JWT_REFRESH_SECRET=please-change-me-refresh
# Refresh Token 过期时间，例如 7d / 14d / 30d
JWT_REFRESH_EXPIRES_IN=7d

# ==========================
# 邮件服务配置
# ==========================
# 是否启用邮件发送
MAIL_ENABLED=false
# SMTP 主机地址
MAIL_HOST=smtp.example.com
# SMTP 端口；SSL 通常为 465，STARTTLS 通常为 587
MAIL_PORT=465
# 是否直接使用 SSL/TLS
MAIL_SECURE=true
# 是否忽略 TLS 校验
MAIL_IGNORE_TLS=false
# SMTP 登录用户名
MAIL_USER=
# SMTP 授权码或密码
MAIL_PASS=
# 默认发件人名称
MAIL_FROM_NAME=llmops
# 默认发件邮箱地址
MAIL_FROM_ADDRESS=

# ==========================
# 阿里云 OSS 配置
# ==========================
# 是否启用 OSS 文件直传；false 时文件走本地存储
OSS_ENABLED=false
# OSS 地域，例如 oss-cn-hangzhou / oss-cn-shanghai
OSS_REGION=oss-cn-hangzhou
# Bucket 名称
OSS_BUCKET=
# RAM 用户 AccessKey ID；建议不要使用主账号 AccessKey
OSS_ACCESS_KEY_ID=
# RAM 用户 AccessKey Secret
OSS_ACCESS_KEY_SECRET=
# CDN 或自定义域名；留空则使用 Bucket 默认公网地址
OSS_PUBLIC_BASE_URL=
# 上传签名有效期，单位秒
OSS_UPLOAD_EXPIRES_IN=3600
# 单文件最大上传大小，单位字节；10485760 = 10MB
OSS_UPLOAD_MAX_SIZE=10485760
# pending / uploaded 临时文件保留小时数
OSS_TEMP_EXPIRES_IN_HOURS=24

# ==========================
# 向量检索配置（Qdrant，可选）
# ==========================
# Qdrant 服务地址；默认 http://127.0.0.1:6333
QDRANT_URL=http://127.0.0.1:6333
# Qdrant 集合名称；默认 ai_knowledge_chunks
QDRANT_COLLECTION=ai_knowledge_chunks

# ==========================
# 日志配置
# ==========================
# 是否写入 logs 目录
LOG_ON=true
# 日志级别：error / warn / info / http / verbose / debug / silly
LOG_LEVEL=info

# ==========================
# 环境覆盖文件
# ==========================
# 开发环境覆盖：.env.development（DB_HOST / REDIS_HOST / JWT_* 等）
# 生产环境覆盖：.env.production（务必 DB_SYNC=false）
