{
  "name": "browser-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "run-p type-check build-only --",
    "build-only": "run-s build:popup build:content",
    "build:popup": "vite build",
    "build:content": "vite build --config vite.content.config.ts",
    "dev": "vite build --watch",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@lucide/vue": "^1.22.0",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "npm-run-all2": "^9.0.2",
    "typescript": "~6.0.0",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  }
}
